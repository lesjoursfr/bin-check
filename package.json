{
	"name": "@lesjoursfr/bin-check",
	"version": "8.1.2",
	"description": "Check if a binary is working",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lesjoursfr/bin-check.git"
	},
	"homepage": "https://github.com/lesjoursfr/bin-check#readme",
	"bugs": {
		"url": "https://github.com/lesjoursfr/bin-check/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"author": {
		"name": "Kevin Mårtensson",
		"email": "kevinmartensson@gmail.com",
		"url": "https://github.com/kevva"
	},
	"engines": {
		"node": "22.x || 24.x || 26.x"
	},
	"keywords": [
		"binary",
		"check",
		"executable",
		"test"
	],
	"main": "./lib/index.js",
	"types": "./lib/index.d.ts",
	"type": "module",
	"scripts": {
		"freshlock": "rm -rf node_modules/ && rm .yarn/install-state.gz && rm yarn.lock && yarn",
		"check-lint": "eslint",
		"check-format": "prettier --check .",
		"check-tsc": "tsc --noEmit",
		"lint": "eslint --fix",
		"format": "prettier --write .",
		"build": "tsc",
		"test": "NODE_OPTIONS='--loader=ts-node/esm' mocha"
	},
	"dependencies": {
		"execa": "^10.0.1",
		"isexe": "^4.0.0"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@tsconfig/node22": "22.0.6",
		"@types/mocha": "10.0.10",
		"@types/node": "24.19.0",
		"eslint": "10.11.0",
		"eslint-config-prettier": "10.1.8",
		"globals": "17.13.0",
		"mocha": "12.0.3",
		"prettier": "3.9.9",
		"ts-node": "10.9.2",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.0"
	},
	"packageManager": "yarn@4.18.1"
}
